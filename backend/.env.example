# 复制此文件为 .env，并填入真实值。
# .env 不会被提交到代码仓库（见 .gitignore）。

# 服务监听端口
PORT=3001

# 允许跨域访问的前端地址，多个用逗号分隔；不填则默认放行所有来源（仅建议 demo 阶段使用）
CORS_ORIGIN=

# 阿里云百炼配置 —— 真实值请勿提交到代码仓库
BAILIAN_API_KEY=your_api_key_here
BAILIAN_APP_ID=your_app_id_here
# 百炼应用调用的基础地址，一般不需要修改
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/apps

# 独立的本地知识库问答链路（/api/chat-local，仅供开发者自己对比测试用）
# 调用的是百炼"通用模型对话接口"（OpenAI 兼容模式），不是上面绑定了知识库的百炼 App，
# 复用同一个 BAILIAN_API_KEY 即可，不需要单独填 Key
BAILIAN_GENERIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_GENERIC_MODEL=qwen-plus

# /api/chat-local 要同时查询的本地知识库名字（对应 local-kb-tool/kb-docs/<名字>/），逗号分隔
LOCAL_KB_NAMES=diet,body-composition

# 用户超过多少天没来对话，就在开场白里提示 AI 体现"很久没聊"这件事
INACTIVITY_THRESHOLD_DAYS=3

# 用户数据存储：003只接入腾讯云PostgreSQL连接基础层，不切换业务适配器。
# 当前只能使用 sqlite；后续完整契约通过后才允许切换为 tencent-postgres。
USER_STORE_ADAPTER=sqlite

# LangGraph短期会话状态。默认memory保持现有单实例行为。
# 首次共享PostgreSQL验证必须同时设置：
# backend=postgres、固定确认词、schema版本1.0.4、single_instance_canary、实例上限1，
# 并单独生成至少32字符的HMAC密钥。真实密钥不得提交或写入验收文件。
LANGGRAPH_CHECKPOINTER_BACKEND=memory
LANGGRAPH_CHECKPOINTER_CONFIRM=
LANGGRAPH_CHECKPOINTER_SCHEMA_VERSION=
LANGGRAPH_CHECKPOINTER_MODE=
LANGGRAPH_CHECKPOINTER_MAX_INSTANCES=
LANGGRAPH_THREAD_HMAC_SECRET=

# 腾讯云 MemFire PostgreSQL 连接池（003）。
# 本地假连接池测试不需要填写真实值；CloudBase Run 中由服务环境变量注入。
TENCENT_PG_HOST=
TENCENT_PG_PORT=5432
TENCENT_PG_DATABASE=diet_secretary
TENCENT_PG_USER=diet_app
TENCENT_PG_PASSWORD=
TENCENT_PG_SSL_MODE=require
TENCENT_PG_SSL_CA_BASE64=
TENCENT_PG_POOL_MAX=5
TENCENT_PG_IDLE_TIMEOUT_MS=30000
TENCENT_PG_CONNECT_TIMEOUT_MS=5000
TENCENT_PG_STATEMENT_TIMEOUT_MS=10000
TENCENT_PG_LOCK_TIMEOUT_MS=3000
TENCENT_PG_IDLE_TX_TIMEOUT_MS=15000

# 005i 全量容量与自动回滚信号（当前 full 能力门禁仍为 false；不要在主服务启用）。
# OBSERVED 两项必须来自控制台独立复核，不能直接复制声明值后跳过核对。
RUN_005I_CAPACITY_REVIEW=
TENCENT_PG_FULL_MAX_INSTANCES=
TENCENT_PG_OBSERVED_MAX_INSTANCES=
TENCENT_PG_OBSERVED_POOL_MAX=
TENCENT_PG_DATABASE_MAX_CONNECTIONS=
TENCENT_PG_OPERATIONAL_RESERVE_CONNECTIONS=
TENCENT_PG_FULL_CONNECTION_BUDGET=
RUN_005I_ROLLBACK_POLICY=
TENCENT_PG_ROLLBACK_MIN_SAMPLES=
TENCENT_PG_ROLLBACK_POOL_SATURATION_PCT=
TENCENT_PG_ROLLBACK_WAITING_CLIENTS=
TENCENT_PG_ROLLBACK_READINESS_FAILURES=
TENCENT_PG_ROLLBACK_CONNECTION_TIMEOUT_RATE_PCT=
TENCENT_PG_ROLLBACK_TRANSACTION_FAILURE_RATE_PCT=
TENCENT_PG_ROLLBACK_HTTP_SIDE_EFFECT_FAILURE_RATE_PCT=
TENCENT_PG_ROLLBACK_IDENTITY_FAILURE_RATE_PCT=

# 企业微信内部测试渠道。默认必须关闭；真实值只配置在 CloudBase Run 环境变量或本地 .env。
WECOM_CHANNEL_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_CALLBACK_TOKEN=
# 企业微信后台生成的43位 EncodingAESKey。
WECOM_CALLBACK_ENCODING_AES_KEY=
# 32字节随机密钥的Base64，只用于加密PostgreSQL任务正文和回复，不得提交真实值。
WECOM_JOB_PAYLOAD_KEY_BASE64=
# 逗号分隔的64位 SHA-256 成员摘要；不在环境变量里存放原始 UserID。
WECOM_TEST_ALLOWLIST=
WECOM_INTRO_VERSION=v1
# 回调只负责可靠入队并立即返回；后台Worker通过租约、Outbox和主动消息完成回复。
WECOM_WORKER_POLL_MS=1000
WECOM_WORKER_LEASE_MS=30000
WECOM_WORKER_MAX_ATTEMPTS=8
WECOM_API_TIMEOUT_MS=10000
