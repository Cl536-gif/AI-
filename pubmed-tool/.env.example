# 复制此文件为 .env 可选覆盖以下配置，不复制则全部使用默认值

# 关键词列表，用 | 分隔；不填则使用需求文档里给的默认 5 个关键词
# PUBMED_KEYWORDS=female college students weight management|young women dietary intervention

# 每个关键词抓取最新文献的数量，默认 15（建议 10-20 之间）
PUBMED_RESULTS_PER_KEYWORD=

# NCBI API Key（可选）。不填时限速约 3 次/秒，申请后约 10 次/秒。
# 免费申请地址：https://www.ncbi.nlm.nih.gov/account/settings/ -> API Key Management
PUBMED_API_KEY=

# 联系邮箱和工具名，NCBI 建议携带（非必填，属于调用礼仪，不是强制要求）
PUBMED_EMAIL=
PUBMED_TOOL_NAME=

# 预筛选：发表年份早于这一年的文献会被过滤掉；不填则用 PUBMED_MAX_AGE_YEARS 计算
PUBMED_MIN_YEAR=
# 预筛选：文献超过多少年算"过旧"，默认 15；只在没填 PUBMED_MIN_YEAR 时生效
PUBMED_MAX_AGE_YEARS=

# 预筛选：摘要短于多少字符会被过滤掉，默认 200
PUBMED_MIN_ABSTRACT_LENGTH=

# 候选清单 / 已保留清单的输出目录，默认 ./candidates
PUBMED_OUTPUT_DIR=

# ===== 每周增量更新（npm run weekly-update）=====

# 默认检索最近多少天内新发表的文献，默认 7；也可以每次用 --days 参数临时覆盖
PUBMED_WEEKLY_DAYS=

# 记录已处理过的 PMID，避免重复抓取，默认 data/processed-pmids.json
PUBMED_PROCESSED_STORE=

# AI 辅助打分调用的是阿里云百炼的通用模型接口（不是 backend/ 项目里那个绑定了
# 知识库人设的应用），需要单独配置，跟 backend/.env 是两份独立配置：
# BAILIAN_API_KEY 的值可以直接复用 backend/.env 里那个（同一个阿里云账号的话）
BAILIAN_API_KEY=
# 百炼 OpenAI 兼容模式的地址，默认 https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_BASE_URL=
# 调用的模型，默认 qwen-plus
BAILIAN_MODEL=
# 每篇文献打分之间的等待时间（毫秒），避免请求过于频繁，默认 300
AI_SCORER_DELAY_MS=
