{
  "name": "diet-secretary-backend",
  "version": "0.1.0",
  "private": true,
  "description": "专属饮食秘书 - 后端中间层服务（转发对话请求到阿里云百炼，保护密钥）",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:003a": "node manual-test-postgres-pool-config.js",
    "test:003b": "node manual-test-postgres-transaction.js",
    "test:003c": "node manual-test-postgres-readiness-lifecycle.js",
    "test:003d": "node manual-test-postgres-003d.js",
    "test:003": "npm run test:003a && npm run test:003b && npm run test:003c && npm run test:003d",
    "verify:003d:cloud": "node manual-test-postgres-cloud-verification.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
