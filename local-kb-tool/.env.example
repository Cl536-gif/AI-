# 复制此文件为 .env 可选覆盖以下配置，不复制则全部使用默认值

# 知识库 .docx 文件所在目录，默认 ./kb-docs
KB_DOCS_DIR=

# 本地向量索引存储目录，默认 ./data/index
KB_INDEX_DIR=

# 切分片段的最大字符数，默认 500
KB_CHUNK_CHARS=

# 查询时返回的最相关片段数量，默认 5
KB_TOP_K=

# 本地 embedding 模型（Xenova/transformers.js 支持的模型名）
# 默认 Xenova/bge-small-zh-v1.5（中文专用，检索效果明显好于英文模型）
KB_EMBEDDING_MODEL=

# 查询时自动加在问题前面的检索指令前缀，BGE 系列模型官方推荐用法，默认已内置不用填
# 换了非 BGE 模型不想要这个前缀的话，取消下面这行注释，设成空字符串即可关掉
# KB_QUERY_INSTRUCTION=

# 下载 embedding 模型的地址，默认 https://huggingface.co
# 国内连不上/超时的话，换成镜像站，URL 结构兼容，直接替换即可：
# KB_HF_ENDPOINT=https://hf-mirror.com
KB_HF_ENDPOINT=
