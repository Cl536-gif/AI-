# 复制此文件为 .env 可选覆盖以下配置，不复制则全部使用默认值

# 知识库 .docx 文件所在目录，默认 ./kb-docs
KB_DOCS_DIR=

# 本地向量索引存储目录，默认 ./data/index
KB_INDEX_DIR=

# 切分片段的最大字符数，默认 500
KB_CHUNK_CHARS=

# 查询时返回的最相关片段数量，默认 5
KB_TOP_K=

# 混合检索里关键词重合度的权重（0~1），默认 0.35，语义相似度权重 = 1 减去这个值
# 设成 0 就是纯语义检索，不参考关键词
# KB_KEYWORD_WEIGHT=0.35

# 本地 embedding 模型（Xenova/transformers.js 支持的模型名）
# 默认 Xenova/bge-small-zh-v1.5（中文专用，检索效果明显好于英文模型）
KB_EMBEDDING_MODEL=

# 查询时自动加在问题前面的检索指令前缀，BGE 系列模型官方推荐用法，默认已内置不用填
# 换了非 BGE 模型不想要这个前缀的话，取消下面这行注释，设成空字符串即可关掉
# KB_QUERY_INSTRUCTION=

# 下载 embedding 模型的地址，默认 https://huggingface.co
# 国内连不上/超时的话，换成镜像站，URL 结构兼容，直接替换即可：
# KB_HF_ENDPOINT=https://hf-mirror.com
KB_HF_ENDPOINT=

# 以下几项仅供"检索效果测试"用（gen-test-questions / eval-retrieval），
# 跟检索本身无关，是调用阿里云百炼通用模型接口来批量生成模拟用户问法
# 真实值请勿提交到代码仓库；可以直接复用 backend/.env 里的 BAILIAN_API_KEY（同一个阿里云账号）
BAILIAN_API_KEY=your_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# 要测试的知识库名字，逗号分隔，默认 diet,body-composition
EVAL_KB_NAMES=

# 生成测试问法时，两次调用百炼接口之间的间隔（毫秒），避免触发限速，默认 400
EVAL_GEN_DELAY_MS=
